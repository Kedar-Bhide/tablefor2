rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null && (
        request.auth.uid == userId ||

        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'partnerRequest',
            'pendingPartnerRequest',
            'partnerUid',
            'partnerEmail',
            'unlinkedNotification'
          ])
      );

      match /insights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weightInsights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /meals/{mealId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions', 'comments'])
      );
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid;
    }
    
    match /frequentMeals/{mealId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    
    match /energy_checkins/{checkinId} {
      // Users can only read, update, or delete their own check-ins
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      
      // Users can only create check-ins for themselves
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

  }
}
