rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isPartnerOf(userId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.partnerUid == request.auth.uid;
    }

    function isOwnerOrPartner(userId) {
      return isOwner(userId) || isPartnerOf(userId);
    }

    match /users/{userId} {
      allow read: if isOwnerOrPartner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        // Existing partner updates (when relationship is established)
        isPartnerOf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partnerRequest', 'pendingPartnerRequest', 'partnerUid', 'partnerEmail', 'unlinkedNotification'])
      ) || (
        // Allow any authenticated user to create a partner request on a target user
        // This enables the partner linking feature to work
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['partnerRequest']) &&
        !resource.data.keys().hasAny(['partnerUid'])
      );
      allow delete: if isOwner(userId);

      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      match /weightInsights/{insightId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /meals/{mealId} {
      allow read: if resource.data.uid == request.auth.uid ||
        isPartnerOf(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow delete: if isOwner(resource.data.uid);
      allow update: if isOwner(resource.data.uid) || (
        isPartnerOf(resource.data.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions', 'comments'])
      );
    }

    match /tasks/{taskId} {
      allow read: if isOwner(resource.data.fromUid) || isOwner(resource.data.toUid);
      allow create: if isOwner(request.resource.data.fromUid);
      allow update: if isOwner(resource.data.toUid);
      allow delete: if isOwner(resource.data.fromUid) || isOwner(resource.data.toUid);
    }
    
    match /frequentMeals/{mealId} {
      // Allow listing if authenticated (queries filter by uid)
      allow list: if request.auth != null;
      // Allow reading individual documents if owner
      allow get: if isOwner(resource.data.uid);
      // Allow creating if owner of the uid field
      allow create: if isOwner(request.resource.data.uid);
      // Allow updating if owner
      allow update: if isOwner(resource.data.uid);
      // Allow deleting if owner
      allow delete: if isOwner(resource.data.uid);
    }

  }
}
